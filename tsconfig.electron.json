{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "target": "ES2020",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true
  },
  "include": [
    "electron/**/*",
    "service/env-conflict/elevation-helper.ts",
    "service/env-conflict/elevation-protocol.ts"
  ],
  "exclude": ["node_modules", "dist", "src"]
}
